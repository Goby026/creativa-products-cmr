# ── Supabase ──────────────────────────────────────────────────
# Crea un proyecto en https://supabase.com → Project Settings → API
# Copia aquí la URL y la anon key (la "anon/public" es segura para el front).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Solo para scripts (nunca exponerla en el front) ────────────
# Se usa en `npm run upload:images` para subir las fotos al bucket.
# La encuentras en Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

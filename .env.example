# ── Supabase ──────────────────────────────────────────────────
# Crea un proyecto en https://supabase.com → Project Settings → API
# Copia aquí la URL (https://<tu-proyecto>.supabase.co) y la anon key
# (la "anon/public" es segura para el front). Nunca pongas la service_role aquí.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Imágenes ───────────────────────────────────────────────────
# Sirve las fotos redimensionadas/WebP desde Supabase Storage.
# Pon a "0" si NO tienes activadas las Image Transformations del proyecto.
VITE_IMG_TRANSFORM=1

# ── Solo para scripts (nunca exponerla en el front) ────────────
# Se usa en `npm run upload:images` para subir las fotos al bucket.
# La encuentras en Project Settings → API → service_role.
# Guárdala en tu .env local, NO en este archivo de ejemplo.
SUPABASE_SERVICE_ROLE_KEY=
